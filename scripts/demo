#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# scripts/demo — lance en local les dossiers fictifs de Partiduo avec le
# binaire de la distribution :
#
#   1. binaires de la distribution : ceux du répertoire PARTIDUO_DIST_BIN,
#      sinon construits dans ../partiduo-dist (PARTIDUO_DIST) s'ils manquent
#      ou si ses sources ont changé ;
#   2. dossiers validés (bin/partiduo-demo-valider, construit ici) ;
#   3. bases PostgreSQL partiduo_demo_<dossier> créées (ou vidées avec
#      --reset ; un nom sans « demo » est refusé), identifiants de test
#      générés et écrits dans demo-identifiants.txt (non versionné) ;
#   4. chaque dossier chargé (`partiduo-manage demo charger`) puis vérifié
#      (`partiduo-manage demo verifier`) ;
#   5. un serveur par dossier (`partiduo-server`, PARTIDUO_DEMO=1), services
#      externes simulés.
#
# Adresses : http://<dossier>.partiduo.localhost:<port>/ (8300, 8301… dans
# l'ordre des dossiers lancés). Arrêt : Ctrl-C, ou `scripts/demo stop`
# depuis un autre terminal (crée le fichier d'arrêt demo.stop).
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"

DOSSIERS_ALL="atelier micro liberal foyer"
DOSSIERS="$DOSSIERS_ALL"
BASE_PORT=8300
RESET=0
BUILD=1
SOURCE="$ROOT/dossiers"
STOP_FILE="$ROOT/demo.stop"
STATE_DIR="$ROOT/tmp/demo"
LOG_DIR="$ROOT/tmp/logs"
CREDENTIALS="$ROOT/demo-identifiants.txt"
PG_SOCKET="${PGHOST:-/tmp}"
DIST="${PARTIDUO_DIST:-$ROOT/../partiduo-dist}"

usage() {
  cat <<'USAGE'
Usage : scripts/demo [options]          lance les dossiers de démonstration
        scripts/demo stop               arrête une démonstration en cours

Options :
  --reset             vide les bases et recharge les dossiers (nouveaux identifiants)
  --only LISTE        dossiers à lancer, parmi atelier,micro,liberal,foyer (défaut : tous)
  --port N            premier port (défaut 8300 ; les dossiers lancés à la suite)
  --no-build          ne reconstruit ni la distribution ni le validateur
  -h, --help          cette aide

Environnement :
  PARTIDUO_DIST_BIN   répertoire des binaires de la distribution (partiduo-manage,
                      partiduo-server, partiduo-modeles-pdf) ; sinon construits dans
  PARTIDUO_DIST       la copie de travail de partiduo-dist (défaut ../partiduo-dist)
USAGE
}

die() {
  echo "scripts/demo : $*" >&2
  exit 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    stop)
      touch "$STOP_FILE"
      echo "Arrêt demandé ($STOP_FILE)."
      exit 0
      ;;
    --reset) RESET=1 ;;
    --no-build) BUILD=0 ;;
    --only) [ $# -ge 2 ] || die "--only : liste manquante"; DOSSIERS=$(printf '%s' "$2" | tr ',' ' '); shift ;;
    --only=*) DOSSIERS=$(printf '%s' "${1#*=}" | tr ',' ' ') ;;
    --port) [ $# -ge 2 ] || die "--port : valeur manquante"; BASE_PORT="$2"; shift ;;
    --port=*) BASE_PORT="${1#*=}" ;;
    -h | --help) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
  esac
  shift
done

case "$BASE_PORT" in '' | *[!0-9]*) die "port invalide : $BASE_PORT" ;; esac
for dossier in $DOSSIERS; do
  case " $DOSSIERS_ALL " in *" $dossier "*) ;; *) die "dossier inconnu : $dossier ($DOSSIERS_ALL)" ;; esac
  [ -f "$SOURCE/$dossier/dossier.yml" ] || die "dossier absent : $SOURCE/$dossier"
done

# --- Prérequis -------------------------------------------------------------------

for tool in createdb dropdb psql; do
  command -v "$tool" >/dev/null 2>&1 || die "$tool introuvable (clients PostgreSQL requis)"
done
[ -S "$PG_SOCKET/.s.PGSQL.5432" ] || die "PostgreSQL injoignable par le socket $PG_SOCKET/.s.PGSQL.5432 (PGHOST)"
export PGHOST="$PG_SOCKET"
export SKIP_MARTEN_CLI_PRECOMPILATION=1

# --- Binaires de la distribution et validateur ---------------------------------------

# Vrai si `cible` manque ou si un source .cr des répertoires donnés est plus
# récent.
stale() {
  target="$1"
  shift
  [ ! -x "$target" ] || [ -n "$(find -L "$@" -newer "$target" -name '*.cr' 2>/dev/null | head -n 1)" ]
}

if [ -n "${PARTIDUO_DIST_BIN:-}" ]; then
  BIN=$(CDPATH= cd -- "$PARTIDUO_DIST_BIN" && pwd) || die "PARTIDUO_DIST_BIN introuvable : $PARTIDUO_DIST_BIN"
else
  [ -f "$DIST/shard.yml" ] || die "distribution introuvable : $DIST (PARTIDUO_DIST ou PARTIDUO_DIST_BIN)"
  DIST=$(CDPATH= cd -- "$DIST" && pwd)
  BIN="$DIST/bin"
  if [ "$BUILD" = 1 ]; then
    command -v crystal >/dev/null 2>&1 || die "crystal introuvable (Crystal 1.19.1 requis)"
    command -v shards >/dev/null 2>&1 || die "shards introuvable"
    if [ ! -d "$DIST/lib" ] || [ ! -f "$DIST/lib/.shards.info" ]; then
      echo "== Distribution : dépendances (shards install)"
      (cd "$DIST" && shards install)
    fi
    mkdir -p "$BIN"
    sources="$DIST/src $DIST/config $DIST/manage.cr $DIST/lib/partiduo"
    for dir in "$DIST"/lib/partiduo-*; do sources="$sources $dir/src $dir/ui $dir/config"; done
    # shellcheck disable=SC2086 # $sources : liste de répertoires
    if stale "$BIN/partiduo-manage" $sources; then
      echo "== Distribution : compilation de partiduo-manage (quelques minutes la première fois)"
      (cd "$DIST" && crystal build manage.cr -o bin/partiduo-manage --no-debug)
    fi
    # shellcheck disable=SC2086
    if stale "$BIN/partiduo-server" $sources; then
      echo "== Distribution : compilation de partiduo-server"
      (cd "$DIST" && crystal build src/server.cr -o bin/partiduo-server --no-debug)
    fi
    if stale "$BIN/partiduo-modeles-pdf" "$DIST/lib/partiduo-modeles/src" "$DIST"/lib/asciicrystal*/src; then
      echo "== Distribution : compilation de partiduo-modeles-pdf"
      (cd "$DIST" && crystal build lib/partiduo-modeles/src/partiduo-modeles/pdf.cr -o bin/partiduo-modeles-pdf --no-debug)
    fi
  fi
fi
MANAGE="$BIN/partiduo-manage"
SERVER="$BIN/partiduo-server"
[ -x "$MANAGE" ] || die "$MANAGE absent (relancez sans --no-build, ou PARTIDUO_DIST_BIN)"
[ -x "$SERVER" ] || die "$SERVER absent (relancez sans --no-build, ou PARTIDUO_DIST_BIN)"

VALIDATOR="$ROOT/bin/partiduo-demo-valider"
if [ "$BUILD" = 1 ] && command -v crystal >/dev/null 2>&1 && stale "$VALIDATOR" "$ROOT/src"; then
  echo "== Validateur des dossiers (compilation)"
  mkdir -p "$ROOT/bin"
  crystal build "$ROOT/src/valider.cr" -o "$VALIDATOR" --no-debug
fi
if [ -x "$VALIDATOR" ]; then
  # shellcheck disable=SC2086 # $DOSSIERS : liste de codes
  "$VALIDATOR" "$SOURCE" $DOSSIERS || die "dossiers invalides (voir ci-dessus)"
fi

# --- Identifiants et clés ----------------------------------------------------------

mkdir -p "$STATE_DIR" "$ROOT/tmp/media" "$LOG_DIR"

random_word() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | cut -c1-"$1"
  else
    LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c "$1"
  fi
}

# Mot de passe de test : 20 caractères, majuscule, minuscule et chiffre
# garantis (politique du cœur).
new_password() {
  printf 'Demo-%s-%s7\n' "$(random_word 8)" "$(random_word 6)"
}

SECRET_FILE="$STATE_DIR/secret.key"
if [ ! -s "$SECRET_FILE" ]; then
  (umask 077 && printf '%s\n' "$(random_word 40)$(random_word 24)" >"$SECRET_FILE")
fi
MARTEN_SECRET_KEY=$(cat "$SECRET_FILE")
export MARTEN_SECRET_KEY

# Adresses des utilisateurs d'un dossier, et ses modules et extensions
# (PARTIDUO_MODULES), lus dans ses fichiers par la distribution.
users_of() {
  "$MANAGE" demo utilisateurs --dossier="$1" --source="$SOURCE"
}

modules_of() {
  "$MANAGE" demo modules --dossier="$1" --source="$SOURCE"
}

# Mot de passe d'un utilisateur lu dans demo-identifiants.txt.
password_of() {
  [ -f "$CREDENTIALS" ] || return 0
  awk -v email="$1" '$1 == email { print $2; exit }' "$CREDENTIALS"
}

database_exists() {
  psql -Atqc "SELECT 1 FROM pg_database WHERE datname = '$1'" postgres 2>/dev/null | grep -q 1
}

# --- Bases, chargement et vérification -------------------------------------------------

LOADING=""
for dossier in $DOSSIERS; do
  database="partiduo_demo_$dossier"
  case "$database" in *demo*) ;; *) die "base refusée : $database" ;; esac
  printf '%s' "$database" | grep -Eq '^[a-z_][a-z0-9_]*$' || die "nom de base invalide : $database"

  users=$(users_of "$dossier") || die "$dossier : utilisateurs illisibles"
  [ -n "$users" ] || die "$dossier : aucun utilisateur"
  reset_this=$RESET
  for email in $users; do
    [ -n "$(password_of "$email")" ] || reset_this=1
  done
  [ -f "$STATE_DIR/$database.loaded" ] || reset_this=1
  if [ "$reset_this" = 0 ]; then
    database_exists "$database" || die "base $database absente : relancez avec --reset"
    continue
  fi

  echo "== $dossier : base $database recréée"
  if database_exists "$database"; then dropdb "$database"; fi
  createdb --encoding=UTF8 "$database"
  rm -f "$STATE_DIR/$database.loaded"
  rm -rf "$ROOT/tmp/media/$dossier"
  passwords=""
  for email in $users; do
    password=$(new_password)
    if [ -f "$CREDENTIALS" ]; then
      awk -v email="$email" '$1 != email' "$CREDENTIALS" >"$CREDENTIALS.tmp" && mv "$CREDENTIALS.tmp" "$CREDENTIALS"
    fi
    (umask 077 && printf '%s %s %s\n' "$email" "$password" "$dossier" >>"$CREDENTIALS")
    passwords="${passwords:+$passwords,}$email=$password"
  done
  echo "== $dossier : chargement (journal : tmp/logs/$dossier-charger.log)"
  (
    export DATABASE_URL="postgres:///$database?host=$PG_SOCKET" PARTIDUO_MEDIA_ROOT="$ROOT/tmp/media/$dossier"
    export MARTEN_ENV=development DEMO_PASSWORDS="$passwords"
    "$MANAGE" demo charger --dossier="$dossier" --source="$SOURCE" --reset &&
      "$MANAGE" demo verifier --dossier="$dossier" --source="$SOURCE" &&
      date -u '+%Y-%m-%dT%H:%M:%SZ' >"$STATE_DIR/$database.loaded"
  ) >"$LOG_DIR/$dossier-charger.log" 2>&1 &
  LOADING="$LOADING $dossier:$!"
done

failed=0
for item in $LOADING; do
  dossier=${item%%:*}
  if wait "${item#*:}"; then
    grep -E '^== |^ÉCART' "$LOG_DIR/$dossier-charger.log" || true
  else
    failed=1
    echo "scripts/demo : chargement ou vérification de $dossier en échec :" >&2
    tail -n 20 "$LOG_DIR/$dossier-charger.log" >&2
  fi
done
[ "$failed" = 0 ] || exit 1

# --- Serveurs ---------------------------------------------------------------------------

rm -f "$STOP_FILE"
PIDS=""
PORT=$BASE_PORT
LINES=""
for dossier in $DOSSIERS; do
  database="partiduo_demo_$dossier"
  rm -f "$STATE_DIR/$dossier.ready"
  DATABASE_URL="postgres:///$database?host=$PG_SOCKET" PARTIDUO_MEDIA_ROOT="$ROOT/tmp/media/$dossier" \
    MARTEN_ENV=development PORT="$PORT" PARTIDUO_DEMO=1 PARTIDUO_MODELES_PDF=auto PARTIDUO_MODULES="$(modules_of "$dossier")" \
    PARTIDUO_DEMO_STOP_FILE="$STOP_FILE" PARTIDUO_DEMO_READY_FILE="$STATE_DIR/$dossier.ready" \
    "$SERVER" >>"$LOG_DIR/$dossier-serveur.log" 2>&1 &
  PIDS="$PIDS $!"
  LINES="$LINES
  http://$dossier.partiduo.localhost:$PORT/"
  PORT=$((PORT + 1))
done

stop_all() {
  touch "$STOP_FILE"
  for pid in $PIDS; do wait "$pid" 2>/dev/null || true; done
  rm -f "$STOP_FILE"
  echo "== Démonstration arrêtée."
}
trap 'stop_all; exit 0' INT TERM

for dossier in $DOSSIERS; do
  while [ ! -f "$STATE_DIR/$dossier.ready" ]; do
    alive=0
    for pid in $PIDS; do kill -0 "$pid" 2>/dev/null && alive=1; done
    if [ "$alive" = 0 ]; then
      echo "scripts/demo : un serveur n'a pas démarré (tmp/logs/*-serveur.log)." >&2
      stop_all
      exit 1
    fi
    [ -f "$STOP_FILE" ] && { stop_all; exit 0; }
    sleep 1
  done
done

cat <<SUMMARY

== Démonstration prête :$LINES

Identifiants de test (fichier $CREDENTIALS, non versionné) :
$(for dossier in $DOSSIERS; do awk -v d="$dossier" '$3 == d { printf "  %-32s %s   (%s)\n", $1, $2, $3 }' "$CREDENTIALS"; done)

Services externes simulés (plateforme agréée, TELEDEC, Chorus Pro, URSSAF,
courriel) : rien ne sort de ce poste. Arrêt : Ctrl-C ou « scripts/demo stop ».
SUMMARY

for pid in $PIDS; do wait "$pid" 2>/dev/null || true; done
rm -f "$STOP_FILE"
echo "== Démonstration arrêtée."
